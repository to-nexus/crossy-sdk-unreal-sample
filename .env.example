# ============================================================================
#  Local environment template for CrossySdkUnrealSamp.
#
#  Copy to `.env` and fill in. `.env` is .gitignore'd and is auto-loaded by
#  the Makefile, so `make sdk-install` will pick it up without a separate
#  shell export.
#
#    cp .env.example .env
#    # edit .env and set GITHUB_TOKEN
#    make sdk-install
# ============================================================================

# GitHub Fine-grained PAT with `contents:read` on the SDK registry repo
# (default registry = to-nexus/crossy-sdk-unreal, see crossx-plugins.json).
# Classic PAT with scope `repo` also works if the org hasn't enabled
# fine-grained PATs yet.
GITHUB_TOKEN=
